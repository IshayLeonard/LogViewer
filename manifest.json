{
  "manifest_version": 3,
  "name": "Genesys IVR Log Visualizer",
  "version": "1.3",
  "description": "Parses and visualizes IVR flow logs from JSON.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "options_page": "options.html",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://*.mypurecloud.com/*",
    "https://*.mypurecloud.ie/*",
    "https://*.mypurecloud.jp/*",
    "https://*.mypurecloud.de/*",
    "https://*.pure.cloud/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["vendor/exceljs.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
